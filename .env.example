# ─────────────────────────────────────────────────────────────
# GLOSS & THREAD — environment variables
# Copy to .env (local) or set in your host's dashboard (production).
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Local dev without Postgres: `npm run db:local` serves an embedded database on 5433:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
# Production example (managed Postgres, TLS required):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Canonical public origin, no trailing slash (required in production).
# Used for canonical URLs, sitemaps, Open Graph and JSON-LD. Never guessed.
SITE_URL="http://localhost:3000"
# Set to anything other than "production" on staging/preview so robots.txt blocks crawling.
# SITE_ENV="production"

# Where uploaded images are stored. Must be a PERSISTENT disk in production.
UPLOAD_DIR="./storage/uploads"

# Shared secret for the scheduled-publishing endpoint (/api/cron/publish/).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Newsletter provider — leave empty to hide signup forms (nothing is simulated).
# NEWSLETTER_PROVIDER="buttondown"   # or "mailchimp"
# BUTTONDOWN_API_KEY=""
# MAILCHIMP_API_KEY=""              # format: key-us21
# MAILCHIMP_AUDIENCE_ID=""
# MAILCHIMP_DOUBLE_OPT_IN="true"

# Google Analytics 4 measurement ID (optional). Loaded only when set.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Search Console HTML-tag verification token (optional).
# GOOGLE_SITE_VERIFICATION=""

# Build-time helpers (optional)
# BUILD_CPUS=1                      # limit static-generation workers (needed only with local PGlite)

# create-admin script: supply the password non-interactively (CI only; otherwise you're prompted)
# ADMIN_PASSWORD=""
