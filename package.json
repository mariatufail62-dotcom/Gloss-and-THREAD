{
  "name": "gloss-and-thread",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:local": "node node_modules/@electric-sql/pglite-socket/dist/scripts/server.js --db=./.data/pglite --port=5433 --max-connections=10",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:reset-local": "node node_modules/tsx/dist/cli.mjs scripts/reset-local-db.ts",
    "create-admin": "node node_modules/tsx/dist/cli.mjs scripts/create-admin.ts",
    "media:demo": "node node_modules/tsx/dist/cli.mjs scripts/generate-demo-images.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:smoke": "node node_modules/tsx/dist/cli.mjs scripts/smoke-test.ts",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "engines": {
    "node": ">=20.9"
  }
}
